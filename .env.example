# Docker version settings. docker compose reads this file automatically after `cp .env.example .env`.
# Set both database passwords before the first `docker compose up` (compose refuses to
# start while they are empty); MariaDB only applies them when its data volume is created.

# Port published on every network interface of the host.
APP_PORT=8080
APP_CONTAINER_NAME=team-todo-app
DB_CONTAINER_NAME=team-todo-db
# Container clock; also the site's initial display time zone.
TZ=Asia/Taipei
# Initial values for the first-run setup page; afterwards change them in 管理 › 網站設定.
SITE_NAME=Team
SITE_URL=
# Optional: when set, the first-run setup page also asks for this value, so knowing the
# published default admin password is not enough to take over a fresh, public deployment.
SETUP_TOKEN=
# Leave empty to decide from SITE_URL (https:// → Secure cookies); true/false forces it.
COOKIE_SECURE=

MARIADB_DATABASE=todo
MARIADB_USER=todo
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
